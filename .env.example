# 复制为本目录的 .env.local 再填写。
# Next.js 同时读 .env 和 .env.local；同名变量以 .env.local 为准。
# 本仓库忽略 .env 和 .env.local，密钥只放 .env.local。改完后要重启 npm run dev。

# 会话签名密钥，至少 16 位随机字符串
SESSION_SECRET=

# 可选。忘记密码时的本机重置口令。不填则复用上面的 SESSION_SECRET（需至少 8 位）。
# PASSWORD_RESET_KEY=

# 管理员用户名。这个账号登录后可以打开 /admin。工作台里没有入口。
ADMIN_USERNAME=

# 协议二选一：openai 或 anthropic
# openai：请求 {LLM_BASE_URL}/chat/completions，用 Authorization: Bearer
# anthropic：请求 {LLM_BASE_URL}/v1/messages，用 x-api-key
LLM_PROTOCOL=openai

# ---------- 当前启用：DeepSeek（OpenAI 协议）----------
# 地址要带 /v1。模型常用 deepseek-chat，推理模型用 deepseek-reasoner。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- OpenAI 官方（OpenAI 协议）----------
# 换用时注释掉上面三行，取消下面三行的注释。LLM_API_KEY 优先于 OPENAI_API_KEY。
# LLM_PROTOCOL=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ---------- Anthropic 官方（Anthropic 协议）----------
# 换用时注释掉当前启用的 LLM_PROTOCOL、LLM_BASE_URL、LLM_API_KEY、LLM_MODEL。
# 地址不要自己再加 /v1/messages，程序会补上。LLM_API_KEY 优先于 ANTHROPIC_API_KEY。
# LLM_PROTOCOL=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_VERSION=2023-06-01
# LLM_MAX_TOKENS=4096

# 设为 1 时不调用模型，只返回本地示例。使用上面的真实接口时设为 0。
LLM_MOCK=0

# 可选。覆盖后台成本估算的单价，单位是每 100 万 token 多少元。配错了会继续用内置单价。
# PRICING_JSON={"deepseek-chat":{"inputPerMillion":2,"outputPerMillion":8}}
